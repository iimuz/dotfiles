# /font
theme = ayu
font-family = HackGen Console NF
font-thicken
font-size = 16

# 日本語での文字化け対策とのこと。発生したら試す。
# see: <https://zenn.dev/massa/articles/ghostty-usage>
# font-feature = -dlig

# Window
title = " "
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

# macOS
macos-titlebar-style = tabs
macos-window-shadow = false
# 既定はキーボードレイアウトで決まり、ABC 配列では Option が Alt にならず Option+w が ∑ になる
# true にすると、どの配列でも Option での文字入力 (∑、JIS の Option+¥ によるバックスラッシュなど) は使えない
macos-option-as-alt = true

# マウス設定
mouse-hide-while-typing = true

# Quick terminal
quick-terminal-position = top
quick-terminal-size = 30%,50%
quick-terminal-screen = main
quick-terminal-animation-duration = 0
# 下書きを見ながら他のアプリを操作するので、焦点が外れても隠さない
quick-terminal-autohide = false
# global: のキーは Ghostty にアクセシビリティの権限が無いと効かない
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# key bind は一旦全て消して必要なもののみ設定
