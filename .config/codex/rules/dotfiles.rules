# Claude Code の settings.json の Bash(...) の deny を写した Codex の rules。
# Codex は symlink の .rules を読まないので、setup が ~/.codex/rules/ に写す。
# curl/wget の出力を sh に渡す pipe の形は写さない。Codex は pipe の各コマンドを
# 別々に照合するので、sh そのものを止める rule になってしまう。

prefix_rule(pattern=["gh", "auth", "token"], decision="forbidden")
prefix_rule(pattern=["mise", "exec", "--", "gh", "auth", "token"], decision="forbidden")
prefix_rule(pattern=["gh", "pr", "merge"], decision="forbidden")
prefix_rule(pattern=["mise", "exec", "--", "gh", "pr", "merge"], decision="forbidden")
prefix_rule(pattern=["git", "push", ["--force", "-f"]], decision="forbidden")
prefix_rule(pattern=["git", "rebase"], decision="forbidden")
prefix_rule(pattern=["git", "reset"], decision="forbidden")
prefix_rule(pattern=["rm", ["-f", "-rf"]], decision="forbidden")
prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["gpg"], decision="forbidden")
prefix_rule(pattern=["pass"], decision="forbidden")
prefix_rule(pattern=["security", "find-generic-password"], decision="forbidden")
