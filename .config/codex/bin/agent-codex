#!/usr/bin/env bash
# Codex を GitHub App の bot の名義で起動する。作業するディレクトリについて gh-identity.sh --print が
# 出す gh と git の名義の export を当ててから、受け取った引数のまま codex を呼ぶ。
# 素の `codex` は人の名義のまま動く。

set -euo pipefail

# codex は -C/--cd のディレクトリで作業するので、名義もそのディレクトリの origin で決める。
target_dir="$PWD"
prev=''
for arg in "$@"; do
  [ "$arg" = "--" ] && break
  case "$prev" in
    -C | --cd) target_dir="$arg" ;;
  esac
  # codex の引数の解析は -C<dir> と -C=<dir> も受け付ける。
  case "$arg" in
    --cd=*) target_dir="${arg#--cd=}" ;;
    -C=*) target_dir="${arg#-C=}" ;;
    -C?*) target_dir="${arg#-C}" ;;
  esac
  prev="$arg"
done

# 失敗したときに人の名義で黙って起動しないよう、eval の前に出力を変数で受けて終了コードを見る。
exports="$("$HOME/.config/agents/hooks/gh-identity.sh" --print "$target_dir")" || {
  echo "agent-codex: failed to run $HOME/.config/agents/hooks/gh-identity.sh" >&2
  exit 1
}
eval "$exports"
exec codex "$@"
