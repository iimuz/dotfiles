#!/usr/bin/env bash

set -euo pipefail

function GH_WITH_TOKEN() {
  local -a ENV_VARS=()
  # A token in the gh config dir (e.g. a bot's) must not be overridden by the human token in pass.
  if [ "$(uname)" = "Linux" ] && [ -z "${GH_TOKEN:-}" ] && type pass >/dev/null 2>&1 &&
    ! gh auth token --hostname github.com >/dev/null 2>&1; then
    ENV_VARS+=(
      "GH_TOKEN=$(pass show github/token 2>/dev/null)"
    )
  fi
  readonly ENV_VARS

  env ${ENV_VARS[@]+"${ENV_VARS[@]}"} gh auth git-credential "$@"
}

GH_WITH_TOKEN "$@"
