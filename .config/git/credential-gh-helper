#!/usr/bin/env bash

set -euo pipefail

function GH_WITH_TOKEN() {
  local -a ENV_VARS=()
  # A bot session must fail without its token rather than push with the human token in pass.
  if [ "$(uname)" = "Linux" ] && [ -z "${GH_TOKEN:-}" ] && type pass >/dev/null 2>&1 &&
    [ "${GH_CONFIG_DIR:-}" != "$HOME/.config/gh-agent" ]; then
    ENV_VARS+=(
      "GH_TOKEN=$(pass show github/token 2>/dev/null)"
    )
  fi
  readonly ENV_VARS

  env ${ENV_VARS[@]+"${ENV_VARS[@]}"} gh auth git-credential "$@"
}

GH_WITH_TOKEN "$@"
